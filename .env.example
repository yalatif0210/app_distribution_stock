# Copier en .env (jamais versionné) et remplir. Générer les secrets avec :
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40

DB_USER=redistribution
DB_PASSWORD=
# Clé de signature des jetons de connexion : 32 caractères minimum
JWT_SECRET=
# Mot de passe du compte "admin" au premier démarrage (12 caractères minimum).
# Utilisé seulement tant que admin a le mot de passe par défaut ; à changer ensuite dans l'application.
ADMIN_INITIAL_PASSWORD=
MISTRAL_API_KEY=

# Facultatif
#TZ=Africa/Abidjan
#HTTP_PORT=80
#HTTPS_PORT=443
#VERSION=latest
# Base PostgreSQL externe (sinon le conteneur db est utilisé) :
#SPRING_DATASOURCE_URL=jdbc:postgresql://serveur-bdd:5432/redistribution_stocks

# ── Poste de développement uniquement (Windows) ──
#COMPOSE_FILE=docker-compose.yml;docker-compose.local.yml
#HTTP_PORT=8086

# ── Serveur partagé : derrière le nginx de l'hôte (Linux, séparateur « : ») ──
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
#HTTP_PORT=8095
